defmodule <%= @admin_module %>.Shopify.Catalogue do
  @moduledoc """
  What the admin's Shopify screens read, and the two things they can start.

  Everything here is a local query: the sync already put the catalogue in our
  own tables. Products and collections are edited in Shopify — a change made
  here would be overwritten by the next webhook — so these screens show what
  was synced, link to Shopify for editing, and start a sync.

  Generated by `mix brando_shopify.gen.admin`; yours to change.
  """

  import Ecto.Query

  alias BrandoShopify.Catalog.Collection
  alias BrandoShopify.Catalog.CollectionProduct
  alias BrandoShopify.Catalog.Product
  alias BrandoShopify.Config
  alias BrandoShopify.Sync.Run

  @store "<%= @store %>"

  @doc "The store these screens show, as configured under `config :brando_shopify, stores:`."
  def store, do: @store

  @doc "Every product that has not been deleted in Shopify, drafts and archived ones included."
  def list_products do
    from(p in Product,
      where: p.store == ^@store and is_nil(p.deleted_at),
      order_by: [asc: p.title],
      preload: [
        collections:
          ^from(c in Collection, where: is_nil(c.deleted_at), order_by: [asc: c.title])
      ]
    )
    |> repo().all()
  end

  @doc "Every collection, with how many live products it holds."
  def list_collections do
    counts =
      from(cp in CollectionProduct,
        join: p in Product,
        on: p.id == cp.product_id and p.store == cp.store,
        where: cp.store == ^@store and is_nil(p.deleted_at),
        group_by: cp.collection_id,
        select: %{collection_id: cp.collection_id, products: count(p.id)}
      )

    from(c in Collection,
      left_join: n in subquery(counts),
      on: n.collection_id == c.id,
      where: c.store == ^@store and is_nil(c.deleted_at),
      order_by: [asc: c.title],
      select: {c, coalesce(n.products, 0)}
    )
    |> repo().all()
  end

  @doc """
  The most recent sync runs, newest first — leaving out the change fetches that
  completed with nothing to fetch. The scheduled one runs every quarter of an
  hour, and listing each would bury the runs that did something within a day.
  """
  def list_runs(limit \\ 20) do
    from(r in Run,
      where: r.store == ^@store,
      where: not (r.kind == :reconcile and r.status == :completed and r.object_count == 0),
      order_by: [desc: r.inserted_at],
      limit: ^limit
    )
    |> repo().all()
  end

  @doc "When a sync last completed, or nil."
  def last_completed_at, do: BrandoShopify.Sync.last_completed_at(store: store_name())

  @doc """
  Re-fetches everything Shopify reports as changed since the last completed
  sync. Needs no webhook, so it is the one to use outside production.
  """
  def fetch_changes do
    %{store: @store}
    |> BrandoShopify.Workers.Reconcile.new()
    |> then(&Oban.insert(config().oban_name || Oban, &1))
  end

  @doc """
  Starts a full import: two Shopify bulk operations, products then inventory.

  Shopify tells us each is done with the `bulk_operations/finish` webhook, so a
  full import only completes where Shopify can reach the webhook endpoint.
  """
  def start_full_sync, do: BrandoShopify.Sync.start_full(store: store_name())

  @doc "What an administrator has saved for the store, or nil."
  def settings, do: BrandoShopify.Settings.get(@store)

  @doc "Saves the store's launch state and partner collections."
  def save_settings(attrs), do: BrandoShopify.Settings.update(@store, attrs)

  @doc """
  The partner collections in force, in order: saved, or the ones given to the
  generator until anything is saved.
  """
  def partner_collections,
    do: BrandoShopify.Settings.partner_collections(@store, <%= inspect(@partner_collections) %>)

  @doc "The launch state in force: saved, or from the store's configuration."
  def visibility, do: BrandoShopify.visibility(store_name())

  @doc "When the legal policies were last fetched from Shopify, or nil."
  def policies_synced_at do
    from(p in BrandoShopify.Policies.Policy,
      where: p.store == ^@store,
      select: max(p.synced_at)
    )
    |> repo().one()
  end

  @doc """
  Fetches the legal policies again. Shopify sends no webhook when one changes,
  so this, or a scheduled `BrandoShopify.Workers.Policy`, is how an edit arrives.
  """
  def fetch_policies do
    %{store: @store}
    |> BrandoShopify.Workers.Policy.new()
    |> then(&Oban.insert(config().oban_name || Oban, &1))
  end

  @doc """
  How the fetch `fetch_policies/0` started is getting on: `:running`, `:done`,
  `:retrying` (it failed, and Oban tries again later) or `:failed` (given up).
  """
  def fetch_state(job_id) do
    case Oban.Repo.get(Oban.config(config().oban_name || Oban), Oban.Job, job_id) do
      %Oban.Job{state: "completed"} -> :done
      %Oban.Job{state: "retryable"} -> :retrying
      %Oban.Job{state: state} when state in ~w(discarded cancelled) -> :failed
      %Oban.Job{} -> :running
      # Pruned, which only happens to a finished job.
      nil -> :done
    end
  end

  @doc "When a webhook from Shopify last arrived, or nil."
  def last_webhook_at do
    from(r in BrandoShopify.Webhook.Receipt,
      where: r.store == ^@store,
      select: max(r.inserted_at)
    )
    |> repo().one()
  end

  @doc "Which store this is, and how it is reached."
  def connection do
    config = config()
    %{shop_domain: config.shop_domain, api_version: config.api_version}
  end

  @doc "The product's page in the Shopify admin."
  def admin_url(%Product{legacy_resource_id: id}), do: admin_url("products/#{id}")
  def admin_url(%Collection{legacy_resource_id: id}), do: admin_url("collections/#{id}")

  def admin_url(path) when is_binary(path) do
    store_handle = String.replace_suffix(config().shop_domain, ".myshopify.com", "")
    "https://admin.shopify.com/store/#{store_handle}/#{path}"
  end

  @doc """
  Where the product is on the public site, or nil. Point it at your storefront's
  route; the package cannot know it.
  """
  def public_path(%Product{} = <%= if @shop_path, do: "product", else: "_product" %>) do
<%= if @shop_path do %>    "<%= @shop_path %>/product/#{product.handle}"
<% else %>    nil
<% end %>  end

  defp store_name, do: String.to_existing_atom(@store)
  defp config, do: Config.fetch!(store_name())
  defp repo, do: Config.repo!(config())
end
