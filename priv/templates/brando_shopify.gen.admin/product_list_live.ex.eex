defmodule <%= @admin_module %>.Shopify.ProductListLive do
  @moduledoc """
  The products synced from Shopify, drafts and archived ones included.

  Read-only: Shopify owns this data, and the next webhook would overwrite an
  edit made here. Each row links to the product in the Shopify admin, and to
  its page on the site where it has one.

  Generated by `mix brando_shopify.gen.admin`; yours to change.
  """

  use BrandoAdmin, :live_view
  use Gettext, backend: <%= @admin_module %>.Gettext

  import <%= @admin_module %>.Shopify.Components

  alias BrandoAdmin.Components.Workspace
  alias BrandoShopify.Catalog.Present
  alias <%= @admin_module %>.Shopify.Catalogue

  def mount(_params, _session, socket) do
    if connected?(socket) do
      {:ok,
       socket
       |> assign(:socket_connected, true)
       |> assign(:products, Catalogue.list_products())}
    else
      {:ok, assign(socket, :socket_connected, false)}
    end
  end

  def render(%{socket_connected: false} = assigns) do
    ~H"""
    """
  end

  def render(assigns) do
    ~H"""
    <div class="admin-workspace shopify-workspace">
      <Workspace.header
        title={gettext("Products")}
        subtitle={gettext("What the shop sells, as synced from Shopify. Edit products in Shopify.")}
        icon="package"
      >
        <.tabs current={:products} />
      </Workspace.header>

      <section class="workspace-panel">
        <header class="workspace-panel-heading">
          <div>
            <h2>{gettext("Products")}</h2>
            <p>{gettext("Changes made in Shopify arrive here within minutes.")}</p>
          </div>
          <span>{ngettext("%{count} product", "%{count} products", length(@products))}</span>
        </header>

        <Workspace.empty
          :if={@products == []}
          title={gettext("No products yet")}
          description={gettext("Run a sync to import the catalogue from Shopify.")}
        />

        <div
          :if={@products != []}
          class="workspace-table-scroll"
          tabindex="0"
          role="region"
          aria-label={gettext("Products")}
        >
          <table class="workspace-table">
            <thead>
              <tr>
                <th><span class="workspace-sr-only">{gettext("Image")}</span></th>
                <th>{gettext("Product")}</th>
                <th>{gettext("Vendor")}</th>
                <th>{gettext("Status")}</th>
                <th>{gettext("Price")}</th>
                <th>{gettext("Stock")}</th>
                <th>{gettext("Collections")}</th>
                <th>{gettext("Synced")}</th>
                <th><span class="workspace-sr-only">{gettext("Actions")}</span></th>
              </tr>
            </thead>
            <tbody>
              <tr :for={product <- @products}>
                <td><.thumbnail product={product} /></td>
                <td>
                  <strong>{product.title}</strong>
                  <br /><code class="workspace-mono">{product.handle}</code>
                </td>
                <td>{product.vendor}</td>
                <td><.status status={product.status} /></td>
                <td>{Present.price(product).formatted}</td>
                <td>{stock(product)}</td>
                <td>{product.collections |> Enum.map(& &1.title) |> Enum.join(", ")}</td>
                <td>{time(product.synced_at)}</td>
                <td class="row-actions">
                  <a
                    :if={Catalogue.public_path(product)}
                    href={Catalogue.public_path(product)}
                    target="_blank"
                    class="btn btn--sm"
                  >
                    {gettext("View")}
                  </a>
                  <a href={Catalogue.admin_url(product)} target="_blank" rel="noopener" class="btn btn--sm">
                    {gettext("Edit in Shopify")} <span aria-hidden="true">&nearr;</span>
                  </a>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>
    </div>
    """
  end

  # Shopify only counts stock for products that track it; "0" would read as
  # sold out for one that simply does not.
  defp stock(%{tracks_inventory: true, total_inventory: count}) when is_integer(count),
    do: to_string(count)

  defp stock(_), do: "—"
end
