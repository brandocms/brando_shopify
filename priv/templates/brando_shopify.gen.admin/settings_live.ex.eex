defmodule <%= @admin_module %>.Shopify.SettingsLive do
  @moduledoc """
  The store's settings: whether the shop is open, which collections are partner
  shops, the legal policies, and how the store is connected.

  Launch state and partner shops are saved in `BrandoShopify.Settings`, so they
  change without a deploy. Everything else here is read from the store's
  configuration; credentials stay there, out of the admin.

  Administrators save; everyone else who can open the screen sees it read-only.

  Generated by `mix brando_shopify.gen.admin`; yours to change.
  """

  use BrandoAdmin, :live_view
  use Gettext, backend: <%= @admin_module %>.Gettext

  import <%= @admin_module %>.Shopify.Components

  alias BrandoAdmin.Components.Workspace
  alias BrandoShopify.Settings
  alias <%= @admin_module %>.Shopify.Catalogue

  on_mount {BrandoAdmin.LiveView.Form, {:hooks_toast, __MODULE__}}

  def mount(_params, _session, socket) do
    if connected?(socket) do
      {:ok,
       socket
       |> assign(:socket_connected, true)
       |> assign(:can_edit?, can_edit?(socket.assigns[:current_user]))
       |> assign(:fetching_policies, false)
       |> assign_state()}
    else
      {:ok, assign(socket, :socket_connected, false)}
    end
  end

  def render(%{socket_connected: false} = assigns) do
    ~H"""
    """
  end

  def render(assigns) do
    ~H"""
    <div class="admin-workspace shopify-workspace">
      <Workspace.header
        title={gettext("Shop settings")}
        subtitle={gettext("Whether the shop is open, and which collections are partner shops.")}
        icon="store"
      >
        <%%!-- Outside the form it submits, so it stays in view at the top as
              Brando's own settings screens have it. --%>
        <button
          :if={@can_edit?}
          type="submit"
          form="shop-settings"
          class="btn btn--primary"
          phx-disable-with={gettext("Saving…")}
        >
          {gettext("Save")}
        </button>
      </Workspace.header>

      <%%!-- Brando spaces panels as siblings (.workspace-panel + .workspace-panel);
            the form between them breaks that, so it keeps the same gap itself. --%>
      <form id="shop-settings" phx-submit="save" style="margin-bottom: 24px">
        <section class="workspace-panel">
          <header class="workspace-panel-heading">
            <div>
              <h2>{gettext("Visibility")}</h2>
              <p>
                {gettext(
                  "Closing the shop hides its pages and the cart. Syncing carries on, so the catalogue is ready the day it opens."
                )}
              </p>
            </div>
            <span><.visibility_badge state={@visibility} /></span>
          </header>

          <fieldset class="shopify-choices" style={@choices_style} disabled={!@can_edit?}>
            <legend class="workspace-sr-only">{gettext("Visibility")}</legend>
            <label :for={state <- Settings.visibility_states()} class="shopify-choice" style={@choice_style}>
              <input
                type="radio"
                style="margin: 0"
                name="settings[visibility]"
                value={state}
                checked={state == @visibility}
              />
              <span style="display: contents">
                <strong>{visibility_label(state)}</strong>
                <small style="grid-column: 2">{visibility_help(state)}</small>
              </span>
            </label>
          </fieldset>
        </section>

        <section class="workspace-panel">
          <header class="workspace-panel-heading">
            <div>
              <h2>{gettext("Partner shops")}</h2>
              <p>
                {gettext(
                  "Collections whose products are made with a partner. They get a shop of their own, and what belongs only to a partner is left out of the main listing."
                )}
              </p>
            </div>
          </header>

          <Workspace.empty
            :if={@collections == []}
            title={gettext("No collections yet")}
            description={gettext("Run a sync to import the catalogue from Shopify.")}
          />

          <fieldset
            :if={@collections != []}
            class="shopify-choices"
            style={@choices_style}
            disabled={!@can_edit?}
          >
            <legend class="workspace-sr-only">{gettext("Partner shops")}</legend>
            <%%!-- An empty value, so unchecking every box saves an empty list
                  rather than leaving the field out. --%>
            <input type="hidden" name="settings[partner_collections][]" value="" />
            <label :for={{collection, count} <- @collections} class="shopify-choice" style={@choice_style}>
              <input
                type="checkbox"
                style="margin: 0"
                name="settings[partner_collections][]"
                value={collection.handle}
                checked={collection.handle in @partner_collections}
              />
              <span style="display: contents">
                <strong>{collection.title}</strong>
                <small style="grid-column: 2">
                  <code class="workspace-mono">{collection.handle}</code> ·
                  {ngettext("%{count} product", "%{count} products", count)}
                </small>
              </span>
            </label>
          </fieldset>

          <p :if={length(@partner_collections) > 1} class="workspace-note">
            {gettext(
              "A product in more than one partner shop belongs to the first: %{order}.",
              order: Enum.join(@partner_collections, ", ")
            )}
          </p>
        </section>

      </form>

      <section class="workspace-panel">
        <header class="workspace-panel-heading" style="border-bottom: 0; border-radius: 6px">
          <div>
            <h2>{gettext("Legal policies")}</h2>
            <p>
              {gettext(
                "Terms, privacy and returns are written in Shopify. Shopify does not say when one changes, so fetch them after an edit."
              )}
            </p>
            <p>{gettext("Last fetched: %{at}", at: time(@policies_synced_at))}</p>
          </div>
          <button
            :if={@can_edit?}
            type="button"
            class="btn"
            phx-click="fetch_policies"
            phx-disable-with={gettext("Starting…")}
            disabled={@fetching_policies}
          >
            {if @fetching_policies, do: gettext("Fetching…"), else: gettext("Fetch policies")}
          </button>
        </header>
      </section>

      <section class="workspace-panel">
        <header class="workspace-panel-heading">
          <div>
            <h2>{gettext("Connection")}</h2>
            <p>{gettext("Set in the application's configuration, with the store's credentials.")}</p>
          </div>
        </header>
        <dl class="workspace-list shopify-facts" style={@choices_style}>
          <div>
            <dt>{gettext("Store")}</dt>
            <dd><code class="workspace-mono">{@connection.shop_domain}</code></dd>
          </div>
          <div>
            <dt>{gettext("API version")}</dt>
            <dd><code class="workspace-mono">{@connection.api_version}</code></dd>
          </div>
          <div>
            <dt>{gettext("Last sync completed")}</dt>
            <dd>
              {time(@last_completed_at)} ·
              <.link navigate="<%= @admin_path %>/sync">{gettext("Sync")}</.link>
            </dd>
          </div>
          <div>
            <dt>{gettext("Last webhook received")}</dt>
            <dd>{time(@last_webhook_at)}</dd>
          </div>
        </dl>
      </section>
    </div>
    """
  end

  attr :state, :atom, required: true

  defp visibility_badge(assigns) do
    ~H"""
    <span class={["badge", "shopify-visibility", "shopify-visibility--#{@state}"]}>
      {visibility_label(@state)}
    </span>
    """
  end

  def handle_event("save", %{"settings" => params}, %{assigns: %{can_edit?: true}} = socket) do
    attrs = %{
      visibility: params["visibility"],
      partner_collections: ordered(params["partner_collections"], socket.assigns.partner_collections)
    }

    case Catalogue.save_settings(attrs) do
      {:ok, _settings} ->
        send(self(), {:toast, gettext("Shop settings saved")})
        {:noreply, assign_state(socket)}

      {:error, _changeset} ->
        send(self(), {:toast, gettext("Could not save the shop settings")})
        {:noreply, socket}
    end
  end

  def handle_event("fetch_policies", _params, %{assigns: %{can_edit?: true}} = socket) do
    case Catalogue.fetch_policies() do
      {:ok, job} ->
        send(self(), {:toast, gettext("Fetching policies from Shopify")})
        {:noreply, socket |> assign(:fetching_policies, true) |> watch_fetch(job.id, 1)}

      {:error, _} ->
        send(self(), {:toast, gettext("Could not start the fetch")})
        {:noreply, socket}
    end
  end

  def handle_event(_event, _params, socket), do: {:noreply, socket}

  # The fetch is a job, so the screen asks after it until it has finished and
  # then reads the new time. It takes a second or two; a minute of asking
  # covers a slow Shopify without watching for ever.
  @watch_every 1_000
  @watch_tries 60

  def handle_info({:watch_fetch, job_id, tries}, socket) do
    case Catalogue.fetch_state(job_id) do
      :done ->
        send(self(), {:toast, gettext("Policies fetched")})

        {:noreply,
         socket
         |> assign(:fetching_policies, false)
         |> assign(:policies_synced_at, Catalogue.policies_synced_at())}

      :retrying ->
        send(self(), {:toast, gettext("Shopify did not answer. The fetch is tried again shortly.")})
        {:noreply, assign(socket, :fetching_policies, false)}

      :failed ->
        send(self(), {:toast, gettext("Could not fetch the policies")})
        {:noreply, assign(socket, :fetching_policies, false)}

      :running when tries < @watch_tries ->
        {:noreply, watch_fetch(socket, job_id, tries + 1)}

      :running ->
        {:noreply, assign(socket, :fetching_policies, false)}
    end
  end

  def handle_info(_message, socket), do: {:noreply, socket}

  defp watch_fetch(socket, job_id, tries) do
    Process.send_after(self(), {:watch_fetch, job_id, tries}, @watch_every)
    socket
  end

  defp assign_state(socket) do
    socket
    # Inline, like the thumbnails: the admin's stylesheet has no rule for these
    # lists, and the screens should need no CSS of the host's.
    |> assign(:choices_style, "display: grid; gap: 14px; margin: 0; padding: 18px 20px; border: 0")
    # The box and the title share the first row, centred on each other whatever
    # their sizes; the description sits under the title in the second column.
    |> assign(
      :choice_style,
      "display: grid; grid-template-columns: auto 1fr; align-items: center; column-gap: 10px; row-gap: 2px; cursor: pointer"
    )
    |> assign(:visibility, Catalogue.visibility())
    |> assign(:partner_collections, Catalogue.partner_collections())
    |> assign(:collections, Catalogue.list_collections())
    |> assign(:policies_synced_at, Catalogue.policies_synced_at())
    |> assign(:last_completed_at, Catalogue.last_completed_at())
    |> assign(:last_webhook_at, Catalogue.last_webhook_at())
    |> assign(:connection, Catalogue.connection())
  end

  # The checked boxes, keeping the order already saved: the first partner shop
  # wins a product that is in two, so checking a new one must not reorder the
  # others. Newly checked ones go last, in the order shown.
  defp ordered(checked, saved) do
    checked = List.wrap(checked) |> Enum.reject(&(&1 == ""))
    Enum.filter(saved, &(&1 in checked)) ++ Enum.reject(checked, &(&1 in saved))
  end

  defp can_edit?(%{role: role}), do: role in [:admin, :superuser]
  defp can_edit?(_), do: false

  defp visibility_label(:off), do: gettext("Closed")
  defp visibility_label(:preview), do: gettext("Preview")
  defp visibility_label(:live), do: gettext("Open")

  defp visibility_help(:off),
    do: gettext("Hidden from everyone, staff included.")

  defp visibility_help(:preview),
    do: gettext("Visible to people signed in to the admin; hidden from everyone else.")

  defp visibility_help(:live),
    do: gettext("Open to everyone.")
end
