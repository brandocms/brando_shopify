defmodule <%= @admin_module %>.Shopify.CollectionListLive do
  @moduledoc """
  The collections synced from Shopify, with how many live products each holds.

  Read-only, like the products: collections are edited in Shopify.

  Generated by `mix brando_shopify.gen.admin`; yours to change.
  """

  use BrandoAdmin, :live_view
  use Gettext, backend: <%= @admin_module %>.Gettext

  import <%= @admin_module %>.Shopify.Components

  alias BrandoAdmin.Components.Workspace
  alias <%= @admin_module %>.Shopify.Catalogue

  def mount(_params, _session, socket) do
    if connected?(socket) do
      {:ok,
       socket
       |> assign(:socket_connected, true)
       |> assign(:collections, Catalogue.list_collections())}
    else
      {:ok, assign(socket, :socket_connected, false)}
    end
  end

  def render(%{socket_connected: false} = assigns) do
    ~H"""
    """
  end

  def render(assigns) do
    ~H"""
    <div class="admin-workspace shopify-workspace">
      <Workspace.header
        title={gettext("Collections")}
        subtitle={gettext("How the products are grouped in Shopify. Edit collections in Shopify.")}
        icon="layers"
      >
        <.tabs current={:collections} />
      </Workspace.header>

      <section class="workspace-panel">
        <header class="workspace-panel-heading">
          <div>
            <h2>{gettext("Collections")}</h2>
            <p>{gettext("Counts include drafts and archived products, but not deleted ones.")}</p>
          </div>
          <span>
            {ngettext("%{count} collection", "%{count} collections", length(@collections))}
          </span>
        </header>

        <Workspace.empty
          :if={@collections == []}
          title={gettext("No collections yet")}
          description={gettext("Run a sync to import the catalogue from Shopify.")}
        />

        <div
          :if={@collections != []}
          class="workspace-table-scroll"
          tabindex="0"
          role="region"
          aria-label={gettext("Collections")}
        >
          <table class="workspace-table">
            <thead>
              <tr>
                <th>{gettext("Collection")}</th>
                <th>{gettext("Handle")}</th>
                <th>{gettext("Products")}</th>
                <th>{gettext("Synced")}</th>
                <th><span class="workspace-sr-only">{gettext("Actions")}</span></th>
              </tr>
            </thead>
            <tbody>
              <tr :for={{collection, count} <- @collections}>
                <td><strong>{collection.title}</strong></td>
                <td><code class="workspace-mono">{collection.handle}</code></td>
                <td>{count}</td>
                <td>{time(collection.synced_at)}</td>
                <td class="row-actions">
                  <a
                    href={Catalogue.admin_url(collection)}
                    target="_blank"
                    rel="noopener"
                    class="btn btn--sm"
                  >
                    {gettext("Edit in Shopify")} <span aria-hidden="true">&nearr;</span>
                  </a>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>
    </div>
    """
  end
end
