defmodule <%= @admin_module %>.Shopify.SyncLive do
  @moduledoc """
  How the catalogue is kept in step with Shopify: the recent sync runs, and the
  two ways to start one.

  * **Fetch changes** re-fetches what Shopify reports as changed since the last
    completed sync. It needs nothing from Shopify's side, so it works anywhere.
  * **Full import** runs two Shopify bulk operations. Shopify reports each done
    with the `bulk_operations/finish` webhook, so a full import only completes
    where Shopify can reach this site — not on a development machine.

  Both are for administrators: a full import is a heavy request against the
  store.

  Generated by `mix brando_shopify.gen.admin`; yours to change.
  """

  use BrandoAdmin, :live_view
  use Gettext, backend: <%= @admin_module %>.Gettext

  import <%= @admin_module %>.Shopify.Components

  alias BrandoAdmin.Components.Workspace
  alias <%= @admin_module %>.Shopify.Catalogue

  on_mount {BrandoAdmin.LiveView.Form, {:hooks_toast, __MODULE__}}

  def mount(_params, _session, socket) do
    if connected?(socket) do
      {:ok,
       socket
       |> assign(:socket_connected, true)
       |> assign(:can_sync?, can_sync?(socket.assigns[:current_user]))
       |> assign_runs()}
    else
      {:ok, assign(socket, :socket_connected, false)}
    end
  end

  def render(%{socket_connected: false} = assigns) do
    ~H"""
    """
  end

  def render(assigns) do
    ~H"""
    <div class="admin-workspace shopify-workspace">
      <Workspace.header
        title={gettext("Sync")}
        subtitle={
          gettext("Last completed: %{at}", at: time(@last_completed_at))
        }
        icon="refresh-cw"
      >
        <.tabs current={:sync} />
      </Workspace.header>

      <section :if={@can_sync?} class="workspace-panel">
        <header class="workspace-panel-heading">
          <div>
            <h2>{gettext("Start a sync")}</h2>
            <p>
              {gettext(
                "Webhooks keep the catalogue current on their own, and missed ones are fetched every quarter of an hour. Start one here after a large change in Shopify."
              )}
            </p>
          </div>
        </header>
        <div class="workspace-heading-actions">
          <button
            type="button"
            class="btn btn--primary"
            phx-click="fetch_changes"
            phx-disable-with={gettext("Starting…")}
          >
            {gettext("Fetch changes")}
          </button>
          <button
            type="button"
            class="btn"
            phx-click="full_import"
            phx-disable-with={gettext("Starting…")}
            data-confirm={
              gettext(
                "Import the whole catalogue again? It completes when Shopify reports back through its webhook."
              )
            }
          >
            {gettext("Full import")}
          </button>
        </div>
      </section>

      <section class="workspace-panel">
        <header class="workspace-panel-heading">
          <div>
            <h2>{gettext("Recent runs")}</h2>
            <p>{gettext("Full imports, change fetches that found something, and single products, newest first.")}</p>
          </div>
          <button type="button" class="btn btn--sm" phx-click="refresh">
            {gettext("Refresh")}
          </button>
        </header>

        <Workspace.empty
          :if={@runs == []}
          title={gettext("No syncs yet")}
          description={gettext("Start one above to import the catalogue from Shopify.")}
        />

        <div
          :if={@runs != []}
          class="workspace-table-scroll"
          tabindex="0"
          role="region"
          aria-label={gettext("Recent runs")}
        >
          <table class="workspace-table">
            <thead>
              <tr>
                <th>{gettext("Kind")}</th>
                <th>{gettext("Status")}</th>
                <th>{gettext("Objects")}</th>
                <th>{gettext("Started")}</th>
                <th>{gettext("Completed")}</th>
                <th>{gettext("Error")}</th>
              </tr>
            </thead>
            <tbody>
              <tr :for={run <- @runs}>
                <td>{kind_label(run)}</td>
                <td><.status status={run.status} /></td>
                <td>{run.object_count}</td>
                <td>{time(run.started_at || run.inserted_at)}</td>
                <td>{time(run.completed_at)}</td>
                <td>{error_message(run.error)}</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>
    </div>
    """
  end

  def handle_event("refresh", _params, socket), do: {:noreply, assign_runs(socket)}

  def handle_event("fetch_changes", _params, %{assigns: %{can_sync?: true}} = socket) do
    case Catalogue.fetch_changes() do
      {:ok, _job} -> send(self(), {:toast, gettext("Fetching changes from Shopify")})
      {:error, _} -> send(self(), {:toast, gettext("Could not start the sync")})
    end

    {:noreply, assign_runs(socket)}
  end

  def handle_event("full_import", _params, %{assigns: %{can_sync?: true}} = socket) do
    case Catalogue.start_full_sync() do
      {:ok, _run} ->
        send(self(), {:toast, gettext("Full import started")})

      {:error, error} ->
        send(self(), {:toast, gettext("Could not start: %{message}", message: error_message(error))})
    end

    {:noreply, assign_runs(socket)}
  end

  def handle_event(_event, _params, socket), do: {:noreply, socket}

  defp assign_runs(socket) do
    socket
    |> assign(:runs, Catalogue.list_runs())
    |> assign(:last_completed_at, Catalogue.last_completed_at())
  end

  defp can_sync?(%{role: role}), do: role in [:admin, :superuser]
  defp can_sync?(_), do: false

  defp kind_label(%{kind: :full, phase: phase}),
    do: gettext("Full import (%{phase})", phase: phase_label(phase))

  defp kind_label(%{kind: :reconcile}), do: gettext("Fetch changes")
  defp kind_label(%{kind: :product}), do: gettext("Product")
  defp kind_label(%{kind: :collection}), do: gettext("Collection")

  defp phase_label(:products), do: gettext("products")
  defp phase_label(:inventory), do: gettext("inventory")

  # Errors are stored as maps from BrandoShopify.Error, or arrive as the struct.
  defp error_message(nil), do: ""
  defp error_message(%{message: message}), do: message
  defp error_message(%{"message" => message}), do: message
  defp error_message(other), do: inspect(other)
end
