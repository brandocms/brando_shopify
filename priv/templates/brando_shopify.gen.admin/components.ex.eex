defmodule <%= @admin_module %>.Shopify.Components do
  @moduledoc """
  What the admin's Shopify screens share: the tabs between them, a product's
  thumbnail, and how a status and a time read.

  Generated by `mix brando_shopify.gen.admin`; yours to change.
  """

  use Phoenix.Component
  use Gettext, backend: <%= @admin_module %>.Gettext

  alias BrandoShopify.Catalog.Present

  @tabs [
    {:products, "<%= @admin_path %>/products"},
    {:collections, "<%= @admin_path %>/collections"},
    {:sync, "<%= @admin_path %>/sync"}
  ]

  @doc "The three screens as tabs. `current` is the one shown."
  attr :current, :atom, required: true, values: [:products, :collections, :sync]

  def tabs(assigns) do
    assigns = assign(assigns, :tabs, @tabs)

    ~H"""
    <nav class="segmented-buttons shopify-tabs" aria-label={gettext("Shop")}>
      <.link
        :for={{tab, path} <- @tabs}
        navigate={path}
        class={["btn", tab == @current && "btn--primary"]}
        aria-current={tab == @current && "page"}
      >
        {label(tab)}
      </.link>
    </nav>
    """
  end

  defp label(:products), do: gettext("Products")
  defp label(:collections), do: gettext("Collections")
  defp label(:sync), do: gettext("Sync")

  @doc """
  A small square thumbnail from Shopify's CDN, or an empty square. Shopify
  resizes on request, so this asks for twice the displayed size.
  """
  attr :product, :map, required: true
  attr :size, :integer, default: 48

  def thumbnail(assigns) do
    assigns = assign(assigns, :image, Present.featured_image(assigns.product))

    ~H"""
    <%%!-- Styled inline: the admin's stylesheet has no rule for it, and these
          screens should need no CSS of the host's. --%>
    <span
      class="shopify-thumbnail"
      style={"display: inline-block; width: #{@size}px; height: #{@size}px; overflow: hidden; border-radius: 4px; background: var(--brando-surface-subtle, #f2f2f0)"}
    >
      <img
        :if={@image}
        src={sized(@image.url, @size * 2)}
        alt=""
        width={@size}
        height={@size}
        loading="lazy"
        style="display: block; width: 100%; height: 100%; object-fit: cover"
      />
    </span>
    """
  end

  defp sized(url, width) do
    separator = if String.contains?(url, "?"), do: "&", else: "?"
    "#{url}#{separator}width=#{width}"
  end

  @doc "A product's Shopify status as a badge."
  attr :status, :atom, required: true

  def status(assigns) do
    ~H"""
    <span class={["badge", "shopify-status", "shopify-status--#{@status}"]}>
      {status_label(@status)}
    </span>
    """
  end

  def status_label(:active), do: gettext("Active")
  def status_label(:draft), do: gettext("Draft")
  def status_label(:archived), do: gettext("Archived")
  def status_label(:pending), do: gettext("Pending")
  def status_label(:running), do: gettext("Running")
  def status_label(:completed), do: gettext("Completed")
  def status_label(:failed), do: gettext("Failed")
  def status_label(:cancelled), do: gettext("Cancelled")
  def status_label(other), do: to_string(other)

  @doc "A time in the site's timezone, or a dash."
  def time(nil), do: "—"

  def time(%DateTime{} = at) do
    at
    |> DateTime.shift_zone!(Brando.timezone())
    |> Calendar.strftime("%d.%m.%Y %H:%M")
  end
end
